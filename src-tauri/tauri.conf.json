{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finance",
  "version": "0.1.1",
  "identifier": "com.almatzhanabekov.finance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:telegramd",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Finance",
        "width": 1120,
        "height": 740,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        },
        "backgroundColor": [15, 28, 46, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/finance-telegramd"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
